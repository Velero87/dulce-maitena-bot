# ===============================
# CLAUDE
# ===============================
ANTHROPIC_API_KEY=tu_api_key_de_claude
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===============================
# INSTAGRAM / META
# ===============================
META_GRAPH_VERSION=v25.0
META_ACCESS_TOKEN=tu_token_largo_de_meta
INSTAGRAM_BUSINESS_ACCOUNT_ID=tu_instagram_business_account_id
WHATSAPP_PHONE_NUMBER_ID=tu_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=un_token_que_inventes_para_el_webhook
APP_BASE_URL=https://tu-app.onrender.com
WHATSAPP_TEMPLATE_RESUME=reanudar_conversacion

# ===============================
# NEGOCIO
# ===============================
BUSINESS_NAME=Dulce Maitena
WHATSAPP_NUMBER_DISPLAY=+54 9 XXX XXX XXXX
DEFAULT_CITY=San Luis
ORDER_CATALOG_URL=https://wa.me/549XXXXXXXXXX
ORDER_PRICE_6=$4500
ORDER_PRICE_12=$8500
ORDER_PAYMENT_METHODS=Efectivo o transferencia

# ===============================
# PUBLICACION AUTOMATICA
# ===============================
AUTO_POST_HOUR=10
AUTO_POST_MINUTE=0
TIMEZONE=America/Argentina/San_Luis
DEFAULT_IMAGE_PATH=content/images/alfajor_1.jpg

# ===============================
# WHATSAPP IA
# ===============================
WHATSAPP_AI_ENABLED=true
HUMAN_HANDOFF_KEYWORDS=humano,persona,asesor,pago,transferencia,comprobante,urgente

# ===============================
# OPCIONAL: RESPUESTAS INSTAGRAM
# ===============================
ENABLE_INSTAGRAM_AUTO_REPLY=false
